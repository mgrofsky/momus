  {
   "id": "subtitle",
   "type": "text",
   "x": 40,
   "y": 92,
   "width": 1609.2,
   "height": 45.0,
   "angle": 0,
   "strokeColor": "#334155",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 2,
   "opacity": 100,
   "groupIds": [
    "g-title"
   ],
   "frameId": null,
   "roundness": null,
   "seed": 1021,
   "version": 1,
   "versionNonce": 1028,
   "isDeleted": false,
   "boundElements": null,
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "Where each piece of data the optional AI analyst sees comes from, what is done to it before the model, and where the model's output ends up.\nNothing the model writes changes a record until a person accepts it, and every run keeps a record that ties its answer and proposals to their inputs.",
   "fontSize": 18,
   "fontFamily": 8,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "Where each piece of data the optional AI analyst sees comes from, what is done to it before the model, and where the model's output ends up.\nNothing the model writes changes a record until a person accepts it, and every run keeps a record that ties its answer and proposals to their inputs.",
   "lineHeight": 1.25,
   "autoResize": true
  },
