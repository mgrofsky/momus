  {
   "id": "subtitle",
   "type": "text",
   "x": 40,
   "y": 100,
   "width": 1522.8000000000002,
   "height": 45.0,
   "angle": 0,
   "strokeColor": "#334155",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 2,
   "opacity": 100,
   "groupIds": [],
   "frameId": null,
   "roundness": null,
   "seed": 1021,
   "version": 1,
   "versionNonce": 1028,
   "isDeleted": false,
   "boundElements": null,
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "What decides whether Momus sends anything to a host, and how much. Each input is checked by the green box on its row, and the green\nboxes run top to bottom in the order the code runs them. Only the scanner sends packets, and every packet leaves through its egress firewall.",
   "fontSize": 18,
   "fontFamily": 8,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "What decides whether Momus sends anything to a host, and how much. Each input is checked by the green box on its row, and the green\nboxes run top to bottom in the order the code runs them. Only the scanner sends packets, and every packet leaves through its egress firewall.",
   "lineHeight": 1.25,
   "autoResize": true
  },
