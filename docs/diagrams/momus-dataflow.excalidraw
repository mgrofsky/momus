  {
   "id": "subtitle",
   "type": "text",
   "x": 40,
   "y": 92,
   "width": 1760.4,
   "height": 45.0,
   "angle": 0,
   "strokeColor": "#334155",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
