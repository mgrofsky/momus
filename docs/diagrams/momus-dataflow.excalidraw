   "seed": 1021,
   "version": 1,
   "versionNonce": 1028,
   "isDeleted": false,
   "boundElements": null,
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "Two containers that share no network: only the scanner (Kali) sends packets to scan targets, and only the brain (the web application) talks to a model provider.\nThey exchange files through one-way folders. Every scan starts from an ownership statement and a DNS proof; the optional seeder lists host names from your own DNS.",
   "fontSize": 18,
   "fontFamily": 8,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "Two containers that share no network: only the scanner (Kali) sends packets to scan targets, and only the brain (the web application) talks to a model provider.\nThey exchange files through one-way folders. Every scan starts from an ownership statement and a DNS proof; the optional seeder lists host names from your own DNS.",
   "lineHeight": 1.25,
   "autoResize": true
  },
